{
  "name": "microservice-gateway",
  "version": "1.0.0",
  "description": "API Gateway for microservice architecture - routes and protects requests to downstream services",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "test": "NODE_ENV=test node --test tests/**/*.test.js",
    "test:watch": "NODE_ENV=test node --test --watch tests/**/*.test.js",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "health-check": "curl -f http://localhost:8080/health || exit 1"
  },
  "keywords": [
    "gateway",
    "microservice",
    "api-gateway", 
    "fastify",
    "proxy",
    "authentication",
    "rate-limiting",
    "nodejs"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/microservice-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/microservice-gateway/issues"
  },
  "homepage": "https://github.com/yourusername/microservice-gateway#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/http-proxy": "^11.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "pino-pretty": "^13.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5"
  }
}