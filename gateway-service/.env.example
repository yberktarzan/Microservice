# Environment Configuration

# Server Configuration
PORT=8080
NODE_ENV=development

# Laravel Auth Service JWT Configuration
# These should match your Laravel JWT configuration
JWT_SECRET=change-this-super-secret-jwt-key-in-production-min-32-chars
JWT_ISSUER=laravel-auth-service
JWT_AUDIENCE=microservices

# Auth Service Configuration
AUTH_BASE_URL=http://localhost:8000
AUTH_VALIDATE_URL=http://localhost:8000/api/auth/validate

# Other Microservices
ADMIN_BASE_URL=http://localhost:8001

# Security Configuration
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# Logging Configuration
LOG_LEVEL=info
